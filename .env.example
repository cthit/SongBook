# Copy to .env.local for `pnpm dev`. See README.md for details.

# Public base URL of the songbook
APP_URL=http://localhost:3000

# At least 32 characters, required in production. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Database: the same variables as the old Python backend (DATABASE_URL wins if set)
SONGBOOK_POSTGRES_HOST=localhost
SONGBOOK_POSTGRES_PORT=5432
SONGBOOK_POSTGRES_USER=songbook
SONGBOOK_POSTGRES_PASSWORD=password
SONGBOOK_POSTGRES_DB=postgres
# DATABASE_URL=postgres://songbook:password@localhost:5432/postgres

# Gamma (OpenID Connect provider + client API)
GAMMA_URL=https://gamma.chalmers.it
# GAMMA_INTERNAL_URL=http://gamma:8081   # server to server URL, e.g. inside docker compose
GAMMA_CLIENT_ID=
GAMMA_CLIENT_SECRET=
GAMMA_API_KEY_ID=
GAMMA_API_KEY_TOKEN=
# GAMMA_REDIRECT_URI=http://localhost:3000/auth/callback   # defaults to ${APP_URL}/auth/callback
GAMMA_ADMIN_AUTHORITY=songbook
